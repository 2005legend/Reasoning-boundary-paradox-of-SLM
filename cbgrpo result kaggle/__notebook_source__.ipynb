)

class CBGRPOTrainer(GRPOTrainer):
    def __init__(self, cluster_ids_list, spend_ema, theta, decay, refresh_every,
                 num_generations, sampled_log, *args, **kwargs):
        super().__init__(*args, **kwargs)
        self.cluster_ids_list = cluster_ids_list
