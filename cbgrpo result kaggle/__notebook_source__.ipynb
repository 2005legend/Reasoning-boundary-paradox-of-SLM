    save_steps=CHECKPOINT_INTERVAL, save_total_limit=3, gradient_checkpointing=False,
    bf16=False, fp16=False, logging_steps=10, remove_unused_columns=False,
    report_to="none", seed=42, dataloader_num_workers=0,
    max_grad_norm=1.0,          # cheap insurance against the loss-spike behavior seen last run
)

trainer = CBGRPOTrainer(
    cluster_ids_list=cluster_ids_list, spend_ema=shared_spend_ema,
    visit_counts=shared_visit_counts, theta=THETA_THRESHOLD, decay=DECAY_FACTOR,
    min_visits=MIN_VISITS_BEFORE_GATING, refresh_every=SAMPLER_REFRESH_EVERY,
    num_generations=NUM_GENERATIONS, sampled_log=sampled_cluster_log,
