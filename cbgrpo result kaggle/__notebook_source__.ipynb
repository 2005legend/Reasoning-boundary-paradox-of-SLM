    prompt = f"""Solve this math problem step by step.

Problem: {problem}

Provide your answer in this format:
<reasoning>
[Your reasoning]
</reasoning>
<answer>
[Final number]
</answer>

Solution:"""
    train_data.append({"prompt": prompt, "problem": problem,
                        "ground_truth": answer, "cluster_id": cid})
