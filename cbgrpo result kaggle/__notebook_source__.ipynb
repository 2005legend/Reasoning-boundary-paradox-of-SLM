print("⏳ STEP 6/9: Defining reward function...")

def compute_reward_for_grpo(prompts, completions, **kwargs):
    """Reward function compatible with GRPO trainer."""
    rewards = []
    
    for prompt, completion in zip(prompts, completions):
        reward = 0.0
        
        # Format rewards
        if '<answer>' in completion and '</answer>' in completion:
            reward += 0.2
        if '<reasoning>' in completion and '</reasoning>' in completion:
            reward += 0.2
        
        # Number extraction reward
        answer_match = re.search(r'<answer>\s*(-?\d+(?:[,\.\d]*)?)\s*</answer>', completion, re.IGNORECASE)
        if answer_match:
            reward += 0.6
        
        rewards.append(reward)
    
    return rewards

print("✅ Reward function defined")
print()

