print("⏳ STEP 7/9: Setting up CB-GRPO trainer...")

from trl import GRPOTrainer, GRPOConfig

class CBGRPOTrainer(GRPOTrainer):
    """CB-GRPO Trainer with capacity balancing."""
    
    def __init__(self, n_clusters=16, ema_alpha=0.01, decay_factor=0.9, 
                 theta_threshold=1.2, balance_window=50, *args, **kwargs):
        super().__init__(*args, **kwargs)
        
        self.n_clusters = n_clusters
        self.ema_alpha = ema_alpha
        self.decay_factor = decay_factor
        self.theta_threshold = theta_threshold
        self.balance_window = balance_window
        
        # Initialize spend tracking
        self.spend_ema = torch.ones(self.n_clusters, dtype=torch.float32)
        if torch.cuda.is_available():
            self.spend_ema = self.spend_ema.cuda()
        
        self.step_count = 0
        self.balance_history = []
        
        print(f"   ✅ CB-GRPO initialized (n_clusters={n_clusters})")
    
    def compute_loss(self, model, inputs, return_outputs=False, num_items_in_batch=None):
        # Compute standard GRPO loss (without outputs since GRPO doesn't support it)
        loss = super().compute_loss(model, inputs, return_outputs=False, num_items_in_batch=num_items_in_batch)
        
        # Get cluster IDs
        cluster_ids = inputs.get('cluster_id', None)
        
        if cluster_ids is not None:
            unique_clusters = torch.unique(cluster_ids)
            
            with torch.no_grad():
                batch_loss_val = loss.detach().abs().item()
                
                # Update EMA spend
                for cid in unique_clusters:
                    cid_int = int(cid.item())
                    self.spend_ema[cid_int] = (
                        self.ema_alpha * batch_loss_val +
                        (1 - self.ema_alpha) * self.spend_ema[cid_int]
                    )
            
            # Compute capacity-aware weights
            mean_spend = self.spend_ema.mean()
            cluster_spend = self.spend_ema[cluster_ids.long()]
            ratios = cluster_spend / (mean_spend + 1e-8)
            
            weights = torch.where(
                ratios > self.theta_threshold,
                torch.pow(self.decay_factor, ratios - self.theta_threshold),
                torch.ones_like(ratios)
            )
            
            # Reweight loss
            loss = loss * weights.mean()
            
            # Log balance metrics
            self.step_count += 1
            if self.step_count % self.balance_window == 0:
                gini = self._compute_gini()
                print(f"[Step {self.step_count}] Gini: {gini:.4f}, Mean spend: {mean_spend:.4f}")
        
        return loss
    
    def _compute_gini(self):
        sorted_spend = torch.sort(self.spend_ema)[0]
        n = len(sorted_spend)
        cumsum = torch.cumsum(sorted_spend, dim=0)
        gini = (2 * torch.sum(torch.arange(1, n+1).float().to(sorted_spend.device) * sorted_spend) - 
                (n + 1) * sorted_spend.sum()) / (n * sorted_spend.sum())
        return gini.item()

print("✅ CB-GRPO trainer class defined")
print()

