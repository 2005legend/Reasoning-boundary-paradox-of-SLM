   "source": [
    "## §0 — Install Dependencies"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "0003",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Run once per Kaggle session — takes ~3 minutes\n",
    "import subprocess, sys\n",
    "\n",
    "def pip_install(pkg, quiet=True):\n",
    "    args = [sys.executable, '-m', 'pip', 'install', pkg]\n",
    "    if quiet:\n",
    "        args.append('-q')\n",
    "    subprocess.check_call(args)\n",
    "\n",
    "packages = [\n",
    "    'transformers>=4.44.0',\n",
    "    'peft>=0.12.0',\n",
    "    'accelerate>=0.33.0',\n",
    "    'bitsandbytes>=0.43.0',\n",
    "    'datasets>=2.21.0',\n",
    "    'sentence-transformers>=3.0.0',\n",
    "    'scikit-learn>=1.5.0',\n",
    "    'sympy>=1.12',\n",
    "    'scipy>=1.13.0',\n",
    "    'plotly>=5.22.0',\n",
    "]\n",
    "\n",
    "for pkg in packages:\n",
    "    print(f'Installing {pkg}...')\n",
    "    pip_install(pkg)\n",
    "\n",
    "print('\\n✅ All packages installed.')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "0004",
   "metadata": {},
