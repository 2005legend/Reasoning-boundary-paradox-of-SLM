   "source": [
    "## §11 — Interference Diagnostics (Req 40 / N5)\n",
    "\n",
    "Compute Δ⁺ and ‖Δ‖ from the SELF paper between two checkpoints.  \n",
    "Requires the probing set built in §6 and at least one trained checkpoint."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "0048",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Interference: compare base model vs. RL checkpoint ──────────────────────\n",
    "\n",
    "INTERFERENCE_CHECKPOINT = ACTIVE_CFG.run_dir / 'accelerate_ckpt'  # or any saved step\n",
    "\n",
    "if not torch.cuda.is_available():\n",
    "    print('⚠️  No GPU — skipping interference computation.')\n",
    "elif not INTERFERENCE_CHECKPOINT.exists():\n",
    "    print(f'⚠️  Checkpoint not found at {INTERFERENCE_CHECKPOINT}. Run §7 first.')\n",
    "else:\n",
    "    _probing_path = ARTIFACT_ROOT / 'probing' / 'probing_set.json'\n",
    "    if not _probing_path.exists():\n",
    "        print('⚠️  Probing set not found. Run §6 (Exp 0) first.')\n",
    "    else:\n",
    "        probing = json.loads(_probing_path.read_text())\n",
    "        print(f'Using probing set: {len(probing)} examples')\n",
    "\n",
    "        # Load model, get base log-probs (adapter disabled)\n",
    "        _tok2 = load_tokenizer(ACTIVE_CFG.model_name)\n",
    "        _mdl2 = load_qlora_model(ACTIVE_CFG.model_name, local_process_index=0)\n",
    "\n",
    "        print('Computing log-probs under BASE model...')\n",
    "        with _mdl2.disable_adapter():\n",
    "            lp_base = compute_probing_logprobs(_mdl2, _tok2, probing)\n",
    "\n",
    "        # Load RL adapter\n",
    "        from peft import PeftModel\n",
    "        _rl_mdl = PeftModel.from_pretrained(_mdl2.get_base_model(),\n",
    "                                              str(INTERFERENCE_CHECKPOINT), is_trainable=False)\n",
    "        _rl_mdl.eval()\n",
    "        print('Computing log-probs under RL checkpoint...')\n",
    "        lp_rl = compute_probing_logprobs(_rl_mdl, _tok2, probing)\n",
    "\n",
    "        snap = compute_interference(lp_base, lp_rl)\n",
    "\n",
    "        # Save result\n",
    "        _interf_path = ACTIVE_CFG.run_dir / 'interference_snapshot.json'\n",
    "        _interf_path.write_text(json.dumps({\n",
    "            'gate_type': ACTIVE_CFG.gate.gate_type,\n",
    "            'model_size': ACTIVE_CFG.model_size,\n",
    "            'n_probing_examples': len(probing),\n",
    "            'delta_plus': snap.delta_plus,\n",
    "            'delta_sq': snap.delta_sq\n",
    "        }, indent=2))\n",
    "\n",
    "        print(f'\\n🔬 Interference Snapshot (Req 40):')\n",
    "        print(f'   Δ⁺  = {snap.delta_plus:.4f}  (negative = negative interference / confidence drop)')\n",
    "        print(f'   ‖Δ‖ = {snap.delta_sq:.4f}   (influence magnitude)')\n",
    "        print(f'   Saved to {_interf_path}')\n",
    "        if snap.delta_plus < -0.05:\n",
    "            print('   ⚠️  Significant negative interference detected — RL training is suppressing'\n",
    "                  ' previously-correct solutions.')"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "0049",
   "metadata": {},
   "source": [
    "## §12 — Multi-Seed Delta-Slope Significance Test (Req 42)\n",
    "\n",
    "After running 3+ seeds for each condition, collect shrinkage slopes here and compute bootstrap CIs."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "0050",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Multi-seed delta-slope analysis ─────────────────────────────────────────\n",
    "# Manually enter slopes from eval_log.jsonl (final entry per seed)\n",
    "# OR point this at your artifact dirs and it reads automatically.\n",
    "\n",
    "def read_final_slope(run_dir: Path) -> Optional[float]:\n",
    "    path = run_dir / 'eval_log.jsonl'\n",
    "    if not path.exists(): return None\n",
    "    lines = path.read_text().strip().splitlines()\n",
    "    if not lines: return None\n",
    "    return json.loads(lines[-1])['shrinkage_slope']\n",
    "\n",
    "\n",
    "# ── Collect slopes for each condition across seeds ────────────────────────\n",
    "OUTPUT_ROOT = Path(ACTIVE_CFG.output_root)\n",
    "CONDITIONS  = ['vanilla', 'cb_grpo', 'o_self', 'h_cb_grpo']\n",
    "MODEL_SIZE_EVAL = ACTIVE_CFG.model_size\n",
    "\n",
    "all_slopes: dict[str, list] = {}\n",
    "for gate in CONDITIONS:\n",
    "    exp_dir = OUTPUT_ROOT / f'exp_{gate}' / MODEL_SIZE_EVAL\n",
    "    seed_dirs = sorted([d for d in exp_dir.iterdir() if d.is_dir() and d.name.startswith('seed')]) \\\n",
    "                if exp_dir.exists() else []\n",
    "    slopes = [read_final_slope(sd) for sd in seed_dirs]\n",
    "    slopes = [s for s in slopes if s is not None]\n",
    "    all_slopes[gate] = slopes\n",
    "    print(f'{gate:12s}: {len(slopes)} seed(s)  slopes={[round(s, 4) for s in slopes]}')\n",
    "\n",
    "print()\n",
    "\n",
    "# ── Delta-slope CI vs. vanilla baseline ──────────────────────────────────\n",
    "baseline_slopes = all_slopes.get('vanilla', [])\n",
    "print('Req 42.3-42.4: Delta-slope (condition − vanilla), 95% bootstrap CI')\n",
    "print('-' * 70)\n",
    "for gate in CONDITIONS:\n",
    "    if gate == 'vanilla': continue\n",
    "    cond_slopes = all_slopes.get(gate, [])\n",
    "    if len(cond_slopes) < 2 or len(baseline_slopes) < 2:\n",
    "        print(f'{gate:12s}: INSUFFICIENT SEEDS (need ≥2 per condition — Req 42.1)')\n",
    "        continue\n",
    "    result = bootstrap_delta_slope_ci(cond_slopes, baseline_slopes)\n",
    "    verdict = '✅ DISTINGUISHABLE from noise' if result.excludes_zero else '❌ NOT distinguishable from noise'\n",
    "    print(f'{gate:12s}: Δslope={result.mean_delta:+.4f}  95%CI [{result.ci_lower:+.4f}, {result.ci_upper:+.4f}]'\n",
    "          f'  n={result.n_seeds}  → {verdict}')"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "0051",
   "metadata": {},
   "source": [
    "## §13 — Clustering Basis Ablation (Req 43)\n",
    "\n",
    "Difficulty-aware clustering: replace semantic-only KMeans with `[embedding, solve_rate]` concatenated features.  \n",
    "**Step 1** (this cell): generate per-prompt solve rates from the base model.  \n",
    "**Step 2**: in §5 set `CLUSTERING_BASIS = 'difficulty_aware'` and re-run §7."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "0052",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Generate per-prompt solve rates (Req 43.1)\n",
    "# Saves ARTIFACT_ROOT/solve_rates.json — referenced by training loop when\n",
    "# CLUSTERING_BASIS = 'difficulty_aware'\n",
    "\n",
    "_sr_path = ARTIFACT_ROOT / 'solve_rates.json'\n",
    "\n",
    "if not torch.cuda.is_available():\n",
    "    print('⚠️  No GPU — skip. Run on Kaggle with GPU.')\n",
    "elif _sr_path.exists():\n",
    "    _existing = json.loads(_sr_path.read_text())\n",
    "    print(f'Solve rates already cached: {len(_existing[\"solve_rates\"])} prompts.')\n",
    "    print('Delete ARTIFACT_ROOT/solve_rates.json to recompute.')\n",
    "else:\n",
    "    print('Computing per-prompt base-model solve rates (G=4 rollouts each)...')\n",
    "    _tok_sr = load_tokenizer(ACTIVE_CFG.model_name)\n",
    "    _mdl_sr = load_qlora_model(ACTIVE_CFG.model_name, local_process_index=0)\n",
    "    _tp     = load_gsm8k(_tok_sr, split='train')\n",
    "    _recs_sr = [\n",
    "        {'prompt_id': i, 'cluster_id': 0, 'chat_prompt': p.chat_prompt, 'ground_truth': p.ground_truth}\n",
    "        for i, p in enumerate(_tp)\n",
    "    ]\n",
    "    with _mdl_sr.disable_adapter():\n",
    "        _sr_rout = generate_rollouts(_mdl_sr, _tok_sr, _recs_sr, group_size=4,\n",
    "                                      max_new_tokens=512, temperature=0.7, top_p=0.95,\n",
    "                                      microbatch_prompts=8)\n",
    "    _correct_sr = np.array([\n",
    "        1.0 if answers_equivalent(parse_output(c).boxed, gt) else 0.0\n",
    "        for c, gt in zip(_sr_rout.completions, _sr_rout.ground_truths)\n",
    "    ]).reshape(len(_tp), 4)\n",
    "    _solve_rates_arr = _correct_sr.mean(axis=1)\n",
    "    _sr_path.write_text(json.dumps({'solve_rates': _solve_rates_arr.tolist()}))\n",
    "    print(f'Solve rates computed for {len(_tp)} prompts.')\n",
    "    print(f'  Mean: {_solve_rates_arr.mean():.3f}  '\n",
    "          f'Easy (>0.9): {(_solve_rates_arr > 0.9).mean()*100:.1f}%  '\n",
    "          f'Hard (<0.1): {(_solve_rates_arr < 0.1).mean()*100:.1f}%')"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "0053",
   "metadata": {},
   "source": [
    "## §14 — Cross-Condition Results + Summary Report\n",
    "\n",
    "Run after all conditions and seeds are trained. Produces:\n",
    "- Per-condition shrinkage slope table\n",
    "- Multi-seed delta-slope significance (Req 42)\n",
    "- Gini ↔ interference exploratory correlation (Req 40.6-40.7)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "0054",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Collect all results ──────────────────────────────────────────────────────\n",
    "\n",
    "def _final_gate_gini(run_dir: Path) -> Optional[float]:\n",
    "    log = run_dir / 'train_log.jsonl'\n",
    "    if not log.exists(): return None\n",
    "    lines = log.read_text().strip().splitlines()\n",
    "    if not lines: return None\n",
    "    last = json.loads(lines[-1])\n",
    "    diag = last.get('gate_diagnostic', {})\n",
    "    if 'cluster_spend_ema' not in diag: return None\n",
    "    return gini_coefficient(np.array(diag['cluster_spend_ema']))\n",
    "\n",
    "\n",
    "def _final_interference(run_dir: Path) -> Optional[dict]:\n",
    "    path = run_dir / 'interference_snapshot.json'\n",
    "    return json.loads(path.read_text()) if path.exists() else None\n",
    "\n",
    "\n",
    "OUTPUT_ROOT = Path(ACTIVE_CFG.output_root)\n",
    "CONDITIONS  = ['vanilla', 'cb_grpo', 'o_self', 'h_cb_grpo']\n",
    "MODEL_SIZE_EVAL = ACTIVE_CFG.model_size\n",
    "\n",
    "per_cond_slopes     = {}\n",
    "per_cond_gini       = {}\n",
    "per_cond_delta_plus = {}\n",
    "\n",
    "for gate in CONDITIONS:\n",
    "    exp_dir   = OUTPUT_ROOT / f'exp_{gate}' / MODEL_SIZE_EVAL\n",
    "    seed_dirs = sorted([d for d in exp_dir.iterdir() if d.is_dir() and d.name.startswith('seed')]) \\\n",
    "                if exp_dir.exists() else []\n",
    "    slopes, ginis, dps = [], [], []\n",
    "    for sd in seed_dirs:\n",
    "        s = read_final_slope(sd)\n",
    "        if s is not None: slopes.append(s)\n",
    "        g = _final_gate_gini(sd)\n",
    "        if g is not None: ginis.append(g)\n",
    "        interf = _final_interference(sd)\n",
    "        if interf and 'delta_plus' in interf: dps.append(interf['delta_plus'])\n",
    "    per_cond_slopes[gate]     = slopes\n",
    "    per_cond_gini[gate]       = ginis\n",
    "    per_cond_delta_plus[gate] = dps\n",
    "\n",
    "\n",
    "# ── Print summary report ──────────────────────────────────────────────────\n",
    "print('=' * 70)\n",
    "print(f'SUMMARY REPORT — {MODEL_SIZE_EVAL} | {time.strftime(\"%Y-%m-%d %H:%M\")}')\n",
    "print('=' * 70)\n",
    "\n",
    "print('\\n## Shrinkage slope by condition (less negative = better mitigation)\\n')\n",
    "baseline_slopes = per_cond_slopes.get('vanilla', [])\n",
    "n_seeds_report  = {g: len(s) for g, s in per_cond_slopes.items()}\n",
    "\n",
    "for gate in CONDITIONS:\n",
    "    slopes = per_cond_slopes.get(gate, [])\n",
    "    if not slopes:\n",
    "        print(f'  {gate:12s}: NO RESULTS')\n",
    "        continue\n",
    "    mu = float(np.mean(slopes))\n",
    "    se = float(np.std(slopes) / np.sqrt(len(slopes))) if len(slopes) > 1 else float('nan')\n",
    "    print(f'  {gate:12s}: mean slope = {mu:+.4f}  (±{se:.4f} SE, n={len(slopes)} seeds)')\n",
    "\n",
    "print()\n",
    "print('## Req 42 — Delta-slope significance (bootstrap CI, 5000 samples)\\n')\n",
    "for gate in CONDITIONS:\n",
    "    if gate == 'vanilla': continue\n",
    "    cs = per_cond_slopes.get(gate, [])\n",
    "    if len(cs) < 2 or len(baseline_slopes) < 2:\n",
    "        print(f'  {gate:12s}: INSUFFICIENT SEEDS (≥2 required, Req 42.1)')\n",
    "        continue\n",
    "    r = bootstrap_delta_slope_ci(cs, baseline_slopes)\n",
    "    v = '✅ EXCLUDES ZERO' if r.excludes_zero else '❌ INCLUDES ZERO'\n",
    "    print(f'  {gate:12s}: Δslope={r.mean_delta:+.4f} CI[{r.ci_lower:+.4f},{r.ci_upper:+.4f}] → {v}')\n",
    "\n",
    "print()\n",
    "print('## Req 40.6-40.7 — Gini ↔ shrinkage-slope correlation (EXPLORATORY)\\n')\n",
    "all_g, all_s = [], []\n",
    "for gate in CONDITIONS:\n",
    "    for g2, s2 in zip(per_cond_gini.get(gate, []), per_cond_slopes.get(gate, [])):\n",
    "        all_g.append(g2); all_s.append(s2)\n",
    "if len(all_g) >= 3:\n",
    "    corr = correlate_exploratory(all_g, all_s, 'cluster Gini vs shrinkage slope')\n",
    "    print(f'  pearson_r={corr.pearson_r:.3f}  spearman_r={corr.spearman_r:.3f}  n={corr.n}')\n",
    "    print(f'  ⚠️  {corr.note}')\n",
    "else:\n",
    "    print(f'  Only {len(all_g)} (cond, seed) pairs have Gini data — too few for any correlation.')\n",
    "\n",
    "print()\n",
    "print('## Req 42.4 — Reporting discipline\\n')\n",
    "for gate in CONDITIONS:\n",
    "    cs = per_cond_slopes.get(gate, [])\n",
    "    if gate == 'vanilla' or len(cs) < 2: continue\n",
    "    r = bootstrap_delta_slope_ci(cs, baseline_slopes) if len(baseline_slopes) >= 2 else None\n",
    "    claim = ('The 95% CI EXCLUDES zero — this constitutes a statistically supported improvement claim.'\n",
    "              if (r and r.excludes_zero)\n",
    "              else 'The 95% CI INCLUDES zero — do NOT describe this as an improvement (Req 42.4).')\n",
    "    print(f'  {gate:12s}: {claim}')\n",
    "\n",
    "print()\n",
    "print('=' * 70)\n",
    "\n",
    "# Save report\n",
    "_report_path = ARTIFACT_ROOT / 'reports' / f'summary_{MODEL_SIZE_EVAL}.md'\n",
    "_report_path.parent.mkdir(parents=True, exist_ok=True)\n",
    "# (Report text is shown above; capture from cell output if needed)"
   ]
  },
  {
