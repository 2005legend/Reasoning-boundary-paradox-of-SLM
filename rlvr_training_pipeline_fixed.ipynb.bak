    "        os.environ[\"AWS_SECRET_ACCESS_KEY\"] = user_secrets.get_secret(\"AWS_SECRET_ACCESS_KEY\")\n",
    "        print(\"✅ AWS/S3 credentials loaded for HF S3 compatibility.\")\n",
    "    except Exception:\n",
    "        pass\n",
    "        \n",
    "except Exception as e:\n",
    "    print(\"Warning: Could not load Kaggle Secrets. Ensure you have added HF_TOKEN in Add-ons -> Secrets.\")\n",
