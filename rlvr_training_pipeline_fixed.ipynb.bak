   "source": [
    "# ── Pass@k curve visualization ───────────────────────────────────────────────\n",
    "\n",
    "BASELINE_PATH = Path(ACTIVE_CFG.output_root).parent / 'baseline_pass_at_k.json'\n",
    "\n",
    "if not BASELINE_PATH.exists():\n",
    "    print(f'Baseline not found at {BASELINE_PATH}. Run §6 (Exp 0) first.')\n",
    "else:\n",
    "    baseline_data = json.loads(BASELINE_PATH.read_text())\n",
    "    base_pk = {int(k): v for k, v in baseline_data['pass_at_k'].items()}\n",
    "\n",
    "    fig = go.Figure()\n",
    "    k_vals = sorted(base_pk.keys())\n",
    "    fig.add_trace(go.Scatter(\n",
    "        x=k_vals, y=[base_pk[k] for k in k_vals],\n",
    "        name='Base model', line=dict(color='#6B7280', dash='dash'), mode='lines+markers'\n",
    "    ))\n",
    "\n",
    "    COLORS = {'vanilla': '#EF4444', 'cb_grpo': '#3B82F6', 'o_self': '#10B981', 'h_cb_grpo': '#8B5CF6'}\n",
    "    for gate in CONDITIONS:\n",
    "        # Use the first seed's final eval log for the curve\n",
    "        exp_dir = Path(ACTIVE_CFG.output_root) / f'exp_{gate}' / MODEL_SIZE_EVAL\n",
    "        seed_dirs = sorted([d for d in exp_dir.iterdir() if d.is_dir() and d.name.startswith('seed')]) \\\n",
    "                    if exp_dir.exists() else []\n",
    "        if not seed_dirs: continue\n",
    "        eval_log = seed_dirs[0] / 'eval_log.jsonl'\n",
    "        if not eval_log.exists(): continue\n",
    "        last_eval = json.loads(eval_log.read_text().strip().splitlines()[-1])\n",
    "        rl_pk = {int(k): v for k, v in last_eval['pass_at_k'].items()}\n",
    "        fig.add_trace(go.Scatter(\n",
    "            x=k_vals, y=[rl_pk.get(k, float('nan')) for k in k_vals],\n",
    "            name=gate, line=dict(color=COLORS.get(gate, '#000'), width=2), mode='lines+markers'\n",
    "        ))\n",
    "\n",
    "    fig.update_layout(\n",
    "        title=f'Pass@k Curves — {MODEL_SIZE_EVAL} (shrinkage visible at high k)',\n",
    "        xaxis_title='k', yaxis_title='Pass@k',\n",
    "        xaxis_type='log', height=500\n",
    "    )\n",
    "    fig.show()"
   ]
