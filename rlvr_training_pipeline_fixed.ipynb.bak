   "outputs": [],
   "source": [
    "# ════════════════════════════════════════════════════════════════════════════\n",
    "# EXPERIMENT CONFIGURATION — edit these before running experiments\n",
    "# ════════════════════════════════════════════════════════════════════════════\n",
    "\n",
    "# ── Choose your experiment ──────────────────────────────────────────────────\n",
    "MODEL_SIZE   = '0.5B'       # '0.5B' or '1.5B'\n",
    "GATE_TYPE    = 'vanilla'    # 0.5B: o_self/h_cb_grpo incompatible (Req 33.4); use vanilla or cb_grpo\n",
    "COMPUTE_TIER = 'standard'   # 'smoke' (80 steps) | 'standard' (800) | 'final' (1800)\n",
    "SEED         = 0            # Req 42.1: run seeds 0,1,2 for core comparison\n",
    "EXP_NAME     = f'exp_{GATE_TYPE}'   # used to name the artifact directory\n",
    "\n",
    "# ── Advanced overrides (usually leave at defaults) ──────────────────────────\n",
    "CLUSTERING_BASIS = 'semantic'       # 'semantic' | 'difficulty_aware' (Req 43)\n",
    "COMBINE_OP       = 'multiplicative' # 'multiplicative' | 'min' | 'harmonic_mean' (Req 39.5)\n",
    "KL_BETA          = 0.0              # 0.0 = no KL penalty (standard GRPO)\n",
    "NUM_PPO_EPOCHS   = 1                # >1 to exercise PPO-clip term\n",
    "\n",
    "# ── Build config ─────────────────────────────────────────────────────────────\n",
    "ACTIVE_CFG = ExperimentConfig(\n",
    "    exp_name     = EXP_NAME,\n",
    "    model_size   = MODEL_SIZE,\n",
    "    compute_tier = COMPUTE_TIER,\n",
    "    seed         = SEED,\n",
    "    gate         = GateConfig(\n",
    "        gate_type  = GATE_TYPE,\n",
    "        combine_op = COMBINE_OP,\n",
    "        cb_use_positive_mass_only = True,   # Req 39.2: always True (novelty fix)\n",
    "    ),\n",
    "    optim  = OptimConfig(kl_beta=KL_BETA, num_ppo_epochs=NUM_PPO_EPOCHS),\n",
    "    cluster = ClusterConfig(basis=CLUSTERING_BASIS),\n",
    ")\n",
    "\n",
    "print('Active experiment configuration:')\n",
    "print(f'  model_size   : {ACTIVE_CFG.model_size}  ({ACTIVE_CFG.model_name})')\n",
    "print(f'  gate_type    : {ACTIVE_CFG.gate.gate_type}')\n",
    "print(f'  compute_tier : {ACTIVE_CFG.compute_tier}  ({ACTIVE_CFG.training_steps} steps)')\n",
    "print(f'  seed         : {ACTIVE_CFG.seed}')\n",
    "print(f'  run_dir      : {ACTIVE_CFG.run_dir}')\n",
    "print(f'  combine_op   : {ACTIVE_CFG.gate.combine_op}')\n",
    "print(f'  clustering   : {ACTIVE_CFG.cluster.basis}')"
   ]
  },
