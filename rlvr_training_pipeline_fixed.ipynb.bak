    "import torch\n",
    "\n",
    "if not torch.cuda.is_available():\n",
    "    print('⚠️  CUDA not available — GPU-dependent cells will be skipped.')\n",
    "    print('    Self-test cells (§4) still run correctly without a GPU.')\n",
    "else:\n",
    "    n_gpus = torch.cuda.device_count()\n",
    "    print(f'✅ CUDA available: {n_gpus} GPU(s)')\n",
    "    for i in range(n_gpus):\n",
    "        props = torch.cuda.get_device_properties(i)\n",
    "        vram_gb = props.total_memory / 1e9\n",
    "        print(f'   GPU {i}: {props.name}  |  {vram_gb:.1f} GB VRAM')\n",
    "        if vram_gb < 14:\n",
    "            print(f'   ⚠️  GPU {i} has < 14 GB VRAM — may OOM during 1.5B training.')"
   ]
