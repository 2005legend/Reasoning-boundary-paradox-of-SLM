   "source": [
    "## §1 — Environment Setup (Kaggle Output Directory + Accelerate Config)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "0006",
   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Directory scaffold ──────────────────────────────────────────────────────\n",
    "# On Kaggle: /kaggle/working/ is ephemeral but survives the session.\n",
    "# Save checkpoints here; download them if you need persistence across sessions.\n",
    "\n",
    "ARTIFACT_ROOT = Path('/kaggle/working/artifacts')\n",
    "for subdir in ['clusters', 'probing', 'runs', 'reports', 'figures']:\n",
    "    (ARTIFACT_ROOT / subdir).mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "print(f'Artifact root: {ARTIFACT_ROOT}')\n",
    "print('Subdirectories created:', [d.name for d in ARTIFACT_ROOT.iterdir()])"
   ]
  },
